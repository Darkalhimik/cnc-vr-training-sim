# Copy to .env.local for development.

# Postgres. Locally: `docker compose up -d db` (published on 5433 so it does
# not clash with a Postgres installed on the host). On Vercel: the Neon
# integration sets DATABASE_URL — use its pooled connection string.
DATABASE_URL=postgres://cnc:cnc@localhost:5433/cnc

# Signs sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me

# Optional. Fixed public URL of the app; leave unset to accept localhost and
# *.vercel.app hosts as they come.
# BETTER_AUTH_URL=https://cnc.example.com
# Extra hosts allowed when BETTER_AUTH_URL is unset, comma-separated.
# AUTH_ALLOWED_HOSTS=cnc.local:8443
